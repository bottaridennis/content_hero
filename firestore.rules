rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funzioni di Aiuto ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "dennisbottari@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    function isResponsabile() {
      return isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Responsabile')
      );
    }

    // Validazione base per l'utente
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'role', 'score', 'isApproved']);
    }

    // Validazione base per il task
    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'difficulty', 'status', 'creatorUid', 'assignees']);
    }

    // --- Regole per le Collezioni ---

    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Il Responsabile può aggiornare punteggio e badge di chiunque (per la validazione)
        (isResponsabile() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'badges'])) ||
        // L'utente può aggiornare il proprio profilo (solo campi base)
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'firstName', 'lastName', 'photoUrl']))
      );
      
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      
      allow create: if isResponsabile();
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Il Responsabile può gestire i task (modifica o validazione)
        isResponsabile() ||
        // Il Player può solo accettare o inviare in revisione il task
        (
          request.auth.uid in resource.data.assignees &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['In corso', 'In Revisione']
        )
      );
      
      allow delete: if isResponsabile() || isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          // Permetti all'utente di aggiungersi all'array completedBy
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedBy']) &&
          request.resource.data.completedBy.hasAll(resource.data.completedBy) &&
          request.resource.data.completedBy.size() == resource.data.completedBy.size() + 1 &&
          request.auth.uid in request.resource.data.completedBy &&
          !(request.auth.uid in resource.data.completedBy)
        )
      );
      allow delete: if isAdmin();
    }

    match /metadata/{metadataId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /test/connection {
      allow read: if true;
    }
  }
}
