rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funzioni di aiuto ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isAuthenticated()
        && request.auth.token.email == "dennisbottari@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isOwnerEmail() || (isAuthenticated() && hasProfile() && myProfile().role == 'Admin');
    }

    function isResponsabile() {
      return isAdmin() || (
        isAuthenticated() && hasProfile()
        && myProfile().role == 'Responsabile'
        && myProfile().isApproved == true
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Utenti ---

    match /users/{userId} {
      allow read: if isAuthenticated();

      // Auto-registrazione: solo Player (approvato) o Responsabile (da approvare), punteggio a zero.
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'username', 'role', 'score', 'isApproved'])
        && request.resource.data.uid == userId
        && request.resource.data.score == 0
        && (
          request.resource.data.role == 'Player'
          || (request.resource.data.role == 'Responsabile' && request.resource.data.isApproved == false)
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin()
        // Il Responsabile aggiorna solo punteggio e badge (validazioni, sfide, correzioni manuali)
        || (isResponsabile() && changedKeys().hasOnly(['score', 'badges']))
        // L'utente aggiorna il proprio profilo anagrafico e il flag di cambio password
        || (
          request.auth.uid == userId
          && changedKeys().hasOnly(['username', 'firstName', 'lastName', 'photoUrl', 'mustChangePassword'])
          && (!('mustChangePassword' in changedKeys()) || request.resource.data.mustChangePassword == false)
        )
      );

      allow delete: if isAdmin();
    }

    // --- Task ---

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isResponsabile();
      allow delete: if isResponsabile();

      allow update: if isAuthenticated() && (
        isResponsabile()
        // L'assegnatario può accettare, consegnare o ritirare la propria consegna
        || (
          request.auth.uid in resource.data.assignees
          && resource.data.status != 'Completato'
          && changedKeys().hasOnly(['status', 'acceptedBy', 'submittedBy', 'logs'])
          && request.resource.data.status in ['In attesa', 'In corso', 'In Revisione']
          && request.resource.data.logs.diff(resource.data.logs).affectedKeys().hasOnly(['acceptedAt', 'submittedAt'])
        )
      );
    }

    // --- Sfide ---

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isResponsabile();
      allow update: if isAuthenticated() && (
        isResponsabile()
        // Un utente può solo aggiungersi a pendingBy (segnalazione di completamento)
        || (
          changedKeys().hasOnly(['pendingBy'])
          && request.resource.data.pendingBy.hasAll(resource.data.get('pendingBy', []))
          && request.resource.data.pendingBy.size() == resource.data.get('pendingBy', []).size() + 1
          && request.auth.uid in request.resource.data.pendingBy
          && !(request.auth.uid in resource.data.completedBy)
        )
      );
    }

    // --- Riscatto premi ---

    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Richiesto'
        && request.resource.data.cost is int
        && request.resource.data.cost > 0;
      allow update, delete: if isResponsabile();
    }

    // --- Configurazione ---

    match /metadata/{metadataId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
